# API Base URL Configuration (no version; each endpoint uses /v1 or /v2 etc.)
# Copy this file to .env and update with your backend URL
#
# For local development (backend running on localhost:8186):
VITE_API_BASE_URL=http://localhost:8186/api
#
# For production or Docker setup, update this to your backend URL:
# VITE_API_BASE_URL=https://capi.yourdomain.com/api
