# /root/cpanel/deployment/config.env: settings that are not secret. Secrets go in ./secrets/, never here.
CPANEL_LOG_LEVEL=info
CPANEL_PUBLIC_ORIGIN=https://cpanel.lynxlinkage.com
CPANEL_DISCORD_CLIENT_ID=
CPANEL_DISCORD_GUILD_ID=
CPANEL_DISCORD_ROLE_ID=
# Shared by every worker replica on this host. An HTTP 418 pauses this egress.
CPANEL_EGRESS=172.237.19.123
CPANEL_MFTIKO_URL=http://100.65.26.119:8080/api/v1
CPANEL_SYM_URL=http://100.65.26.119:7450
