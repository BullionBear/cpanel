# Copy to .env for local development
DEBUG=true
DATABASE_URL=postgresql://cpanel:cpanel@localhost:5432/cpanel
FRONTEND_URL=http://localhost:5173

# Background scheduler (set false for one-off scripts)
SCHEDULER_ENABLED=true

# Envelope-encryption master key for stored exchange credentials.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# JWT signing key. Required when DEBUG=false; if empty in DEBUG an ephemeral
# key is generated (all sessions invalidate on restart).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Discord OAuth (values from the Discord Developer Portal)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_REQUIRED_ROLE_ID=
DISCORD_REDIRECT_URI=http://localhost:8186/auth/discord/callback
